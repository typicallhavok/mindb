      "Bash(git status *)",
      "Bash(go build *)",
      "Bash(tee /tmp/build.log)",
      "Bash(echo \"EXIT:$?\")"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
